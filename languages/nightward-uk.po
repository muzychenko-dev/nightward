msgstr "Адміністратор %2$s: %1$s змінив %3$s"

#: includes/monitor/class-privilege-guard.php:230
msgid ""
"Credentials of an administrator were changed by plugin/theme code, not "
"through the profile or password-reset screens."
msgstr ""
