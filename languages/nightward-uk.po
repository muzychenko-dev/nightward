#. Plugin Name of the plugin
#: nightward.php includes/class-events.php:48
msgid "Nightward"
msgstr "Nightward"

#. Plugin URI of the plugin
#: nightward.php
msgid "https://nightward.muzychenko.dev"
msgstr "https://nightward.muzychenko.dev"

#. Description of the plugin
#: nightward.php
msgid ""
"Runtime security monitor: sees what plugins and themes actually do — "
"outbound requests, faked HTTP responses, new hooks on login and capability "
"checks, administrators created from code, file changes in premium plugins — "
"and emails you a daily report."
msgstr ""
"Монітор безпеки під час роботи сайту: бачить, що плагіни й теми роблять "
"насправді - вихідні запити, підроблені HTTP-відповіді, нові хуки на вході та"
" перевірці прав, адміністраторів, створених кодом, зміни файлів преміум-"
"плагінів - і щодня надсилає звіт на пошту."

#. Author of the plugin
#: nightward.php
msgid "Ihor Muzychenko"
msgstr "Ігор Музиченко"

#. Author URI of the plugin
#: nightward.php
msgid "https://muzychenko.dev"
msgstr "https://muzychenko.dev"

