msgstr "створено обліковий запис"

#: includes/monitor/class-privilege-guard.php:118
msgid "role changed"
msgstr "змінено роль"

#: includes/monitor/class-privilege-guard.php:119
msgid "role added"
msgstr "додано роль"

#: includes/monitor/class-privilege-guard.php:120
msgid "network super admin"
msgstr "суперадміністратор мережі"

#: includes/monitor/class-privilege-guard.php:121
